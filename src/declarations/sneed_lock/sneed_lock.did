type Value__1 = 
 variant {
   Array: vec Value__1;
   Blob: blob;
   Int: int;
   Map: vec record {
              text;
              Value__1;
            };
   Nat: nat;
   Text: text;
 };
type Value = 
 variant {
   Array: vec Value;
   Blob: blob;
   Int: int;
   Map: vec record {
              text;
              Value;
            };
   Nat: nat;
   Text: text;
 };
type TxIndex = nat;
type TransferTokenLockOwnershipResult = 
 variant {
   Err: TransferTokenLockOwnershipError;
   Ok;
 };
type TransferTokenLockOwnershipError = 
 record {
   message: text;
   transfer_error: opt TransferError;
 };
type TransferResult__1 = 
 variant {
   Err: TransferError__1;
   Ok: nat;
 };
type TransferResult = 
 variant {
   Err: TransferError;
   Ok: TxIndex;
 };
type TransferPositionResult = 
 variant {
   err: TransferPositionError;
   ok: bool;
 };
type TransferPositionOwnershipResult = 
 variant {
   Err: TransferPositionOwnershipError;
   Ok;
 };
type TransferPositionOwnershipError = record {message: text;};
type TransferPositionError = 
 variant {
   CommonError;
   InsufficientFunds;
   InternalError: text;
   UnsupportedToken: text;
 };
type TransferFromResult = 
 variant {
   Err: TransferFromError;
   Ok: nat;
 };
type TransferFromError = 
 variant {
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InvalidRecipient;
   NonExistingTokenId;
   TooOld;
   Unauthorized;
 };
type TransferFromArg = 
 record {
   created_at_time: opt nat64;
   from: Account;
   memo: opt blob;
   spender_subaccount: opt blob;
   to: Account;
   token_id: nat;
 };
type TransferError__1 = 
 variant {
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InvalidRecipient;
   NonExistingTokenId;
   TooOld;
   Unauthorized;
 };
type TransferError = 
 variant {
   BadBurn: record {min_burn_amount: Balance;};
   BadFee: record {expected_fee: Balance;};
   CreatedInFuture: record {ledger_time: Timestamp;};
   Duplicate: record {duplicate_of: TxIndex;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientFunds: record {balance: Balance;};
   TemporarilyUnavailable;
   TooOld;
 };
type TransferArg = 
 record {
   created_at_time: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   to: Account;
   token_id: nat;
 };
type TokenType = principal;
type TokenApproval = 
 record {
   approval_info: ApprovalInfo;
   token_id: nat;
 };
type Timestamp = nat64;
type SwapCanisterId = principal;
type SupportedStandard = 
 record {
   name: text;
   url: text;
 };
type Subaccount = blob;
type Status = 
 record {
   governance: principal;
   neuron: opt blob;
   registrations: vec Registration;
 };
type SneedLock = 
 service {
   /// Add liquidity to a locked ICPSwap position from the caller's backend
   /// wallet. Amounts are in base units; either may be zero (out-of-range
   /// positions take only one token). Tokens the pool does not use, because the
   /// price moved since the amounts were chosen, are returned to the caller's
   /// backend wallet. Only the current owner of the lock may add.
   add_liquidity_to_locked_position: (swap_canister_id: SwapCanisterId,
    position_id: PositionId, amount0: nat, amount1: nat) ->
    (AddLiquidityResult);
   admin_add_admin: (new_admin: principal) -> (variant {
                                                 Err: text;
                                                 Ok: text;
                                               });
   admin_clear_completed_claim_requests: () -> (nat);
   admin_clear_failed_claim_requests: () -> (nat);
   admin_get_payment_log: (offset: nat, limit: nat) ->
    (record {
       has_more: bool;
       payments: vec PaymentLogEntry;
       total_count: nat;
     }) query;
   admin_get_payment_log_count: () -> (nat) query;
   admin_get_pool_unused_balance: (swap_canister_id: SwapCanisterId) ->
    (variant {
       Err: text;
       Ok: record {
             balance0: nat;
             balance1: nat;
           };
     });
   /// Write the log start and import blocks if that has not happened yet.
   /// Returns the number of blocks written (0 when already imported).
   admin_icrc3_import_history: () -> (variant {
                                        Err: text;
                                        Ok: nat;
                                      });
   /// Submit the pending registration proposals now instead of at the next spill check.
   admin_icrc3_register_archives_now: () -> (variant {
                                               Err: text;
                                               Ok: nat;
                                             });
   /// Re-apply the intended controllers (this canister and SNS root) to every archive.
   admin_icrc3_repair_archive_controllers: () ->
    (vec record {
           principal;
           variant {
             Err: text;
             Ok;
           };
         });
   /// Forget an archive's proposal (after a rejection) so a new one is submitted.
   admin_icrc3_reset_archive_registration: (canister_id: principal) ->
    (variant {
       Err: text;
       Ok: bool;
     });
   /// Move every live block to the archives now (creating archives as needed).
   /// Returns the number of blocks moved.
   admin_icrc3_spill_now: () -> (variant {
                                   Err: text;
                                   Ok: nat;
                                 });
   admin_pool_deposit: (swap_canister_id: SwapCanisterId, token_ledger:
    TokenType, amount: nat) -> (variant {
                                  Err: text;
                                  Ok: nat;
                                });
   admin_remove_admin: (admin_to_remove: principal) ->
    (variant {
       Err: text;
       Ok: text;
     });
   admin_rescue_stuck_tokens: (token_ledger: TokenType, recipient:
    principal) -> (variant {
                     Err: text;
                     Ok: text;
                   });
   admin_return_token: (icrc1_ledger_canister_id: principal, amount: 
    nat, user_principal: principal) -> (TransferResult);
   admin_return_token_from_failed_request: (icrc1_ledger_canister_id:
    principal, amount: nat, recipient_principal: principal) ->
    (TransferResult);
   admin_set_icp_fee_recipient: (recipient_principal: opt principal,
    recipient_subaccount: opt blob) -> (variant {
                                          Err: text;
                                          Ok: text;
                                        });
   /// The SNS neuron (32-byte id) that has this canister as a hotkey and submits
   /// the registration proposals; null switches the step off.
   admin_set_icrc3_proposal_neuron: (neuron: opt blob) ->
    (variant {
       Err: text;
       Ok;
     });
   admin_set_icrc3_settings: (update: SettingsUpdate) ->
    (variant {
       Err: text;
       Ok: Settings;
     });
   admin_set_lock_fees_icp: (token_lock_fee: opt nat64, position_lock_fee:
    opt nat64, premium_token_lock_fee: opt nat64, premium_position_lock_fee:
    opt nat64) -> (variant {
                     Err: text;
                     Ok: text;
                   });
   admin_set_sneed_premium_canister_id: (canister_id: opt principal) ->
    (variant {
       Err: text;
       Ok: text;
     });
   admin_withdraw_pool_balance_to_user: (swap_canister_id: SwapCanisterId,
    token_ledger: TokenType, amount: nat, user: principal) ->
    (variant {
       Err: text;
       Ok: nat;
     });
   claim_position: (swap_canister_id: principal, position_id: PositionId) ->
    (bool);
   /// Claim the accrued trading fees of a locked position. The pool delivers
   /// them to the caller's wallet subaccount on this canister.
   claim_position_fees: (swap_canister_id: SwapCanisterId, position_id:
    PositionId) -> (ClaimFeesResult);
   clear_expired_locks: () -> ();
   clear_expired_position_locks: () -> ();
   /// `dissolve_delay` (v2, optional): with one, the lock period may be zero, the limits apply
   /// to period + delay, and the tokens stay locked until the lock has dissolved.
   create_lock: (amount: nat, icrc1_ledger_canister_id: principal,
    expires_at: Expiry, dissolve_delay: opt nat64) -> (CreateLockResult);
   create_position_lock: (swap_canister_id: principal, dex: Dex, position_id:
    PositionId, expires_at: Expiry, token0: TokenType, token1: TokenType,
    dissolve_delay: opt nat64) -> (CreateLockResult);
   /// Move the end of the lock period out, for token and position locks. Not while dissolving.
   extend_lock: (lock_id: LockId, new_lock_end: Expiry) -> (LockOpResult);
   getEffectiveLockFee: (user: principal, is_position_lock: bool) ->
    (record {
       fee_e8s: nat64;
       is_premium: bool;
     });
   getPaymentBalance: (user: principal) -> (nat);
   getPaymentSubaccount: (user: principal) -> (blob) query;
   get_active_position_locks: () -> (vec FullyQualifiedPositionLock) query;
   get_active_token_locks: () -> (vec FullyQualifiedLock) query;
   get_admin_list: () -> (vec principal) query;
   get_all_active_claim_requests: () -> (vec ClaimRequest) query;
   get_all_completed_claim_requests: () -> (vec ClaimRequest) query;
   get_all_failed_claim_requests: () -> (vec ClaimRequest) query;
   get_all_position_locks: () -> (vec FullyQualifiedPositionLock) query;
   get_all_token_locks: () -> (vec FullyQualifiedLock) query;
   get_claim_request_status: (request_id: ClaimRequestId) ->
    (opt
      variant {
        Active: ClaimRequest;
        Completed: ClaimRequest;
        Failed: ClaimRequest;
      }) query;
   get_claimed_positions_for_principal: (owner: principal) ->
    (vec ClaimedPosition) query;
   get_completed_claim_request: (request_id: ClaimRequestId) ->
    (opt ClaimRequest) query;
   get_error_entries: (start: nat, length: nat) -> (vec opt BufferEntry);
   get_error_id_range: () -> (opt record {
                                    nat;
                                    nat;
                                  });
   get_expired_position_locks: () -> (vec FullyQualifiedPositionLock) query;
   get_expired_token_locks: () -> (vec FullyQualifiedLock) query;
   get_failed_claim_request: (request_id: ClaimRequestId) ->
    (opt ClaimRequest) query;
   get_info_entries: (start: nat, length: nat) -> (vec opt BufferEntry);
   get_info_id_range: () -> (opt record {
                                   nat;
                                   nat;
                                 });
   get_ledger_token_locks: (ledger_canister_id: TokenType) ->
    (vec FullyQualifiedLock) query;
   get_lock_by_id: (lock_id: LockId) -> (opt LockInfo) query;
   get_lock_fee_stats: () ->
    (record {
       total_fees_collected_e8s: nat;
       total_position_lock_fees_collected_e8s: nat;
       total_token_lock_fees_collected_e8s: nat;
     }) query;
   get_lock_fees_icp: () ->
    (record {
       fee_recipient_principal: opt principal;
       fee_recipient_subaccount: opt blob;
       position_lock_fee_icp_e8s: nat64;
       premium_position_lock_fee_icp_e8s: nat64;
       premium_token_lock_fee_icp_e8s: nat64;
       sneed_premium_canister_id: opt principal;
       token_lock_fee_icp_e8s: nat64;
     }) query;
   get_lock_limits: () -> (LockLimits) query;
   get_lock_state: (lock_id: LockId) -> (opt LockState) query;
   get_lock_states: (lock_ids: vec LockId) -> (vec opt LockState) query;
   /// Locks in ascending id order, filtered by owner, ledger, pool and kind, paged by the last
   /// id seen. Archived (unlocked and cleared) locks only when asked for.
   get_lock_states_page: (q: LockPageQuery) -> (vec LockState) query;
   get_lock_type: (lock_id: LockId) -> (opt LockType) query;
   get_my_claim_history: () -> (vec ClaimRequest) query;
   get_position_lock_by_id: (lock_id: LockId) ->
    (opt FullyQualifiedPositionLock) query;
   /// The NFT of a position, if it has one.
   get_position_nft: (swap_canister_id: SwapCanisterId, position_id:
    PositionId) -> (opt nat) query;
   get_position_ownerships: () ->
    (vec record {
           SwapCanisterId;
           PositionId;
         }) query;
   get_summed_locks: () -> (vec record {
                                  TokenType;
                                  Balance;
                                }) query;
   get_swap_position_locks: (swap_canister_id: SwapCanisterId) ->
    (vec FullyQualifiedPositionLock) query;
   get_token_lock_by_id: (lock_id: LockId) -> (opt FullyQualifiedLock) query;
   get_token_locks: () ->
    (vec record {
           LockId;
           TokenType;
           Balance;
           Expiry;
         }) query;
   get_token_position_locks: (token_canister_id: TokenType) ->
    (vec FullyQualifiedPositionLock) query;
   has_expired_locks: () -> (bool) query;
   has_expired_position_locks: () -> (bool) query;
   icrc10_supported_standards: () -> (vec SupportedStandard) query;
   icrc37_approve_collection: (args: vec ApproveCollectionArg) ->
    (vec opt ApproveCollectionResult);
   icrc37_approve_tokens: (args: vec ApproveTokenArg) ->
    (vec opt ApproveTokenResult);
   icrc37_get_collection_approvals: (owner: Account, prev:
    opt CollectionApproval, take: opt nat) -> (vec CollectionApproval) query;
   icrc37_get_token_approvals: (token_ids: vec nat, prev: opt TokenApproval,
    take: opt nat) -> (vec TokenApproval) query;
   icrc37_is_approved: (args: vec IsApprovedArg) -> (vec bool) query;
   icrc37_max_approvals_per_token_or_collection: () -> (opt nat) query;
   icrc37_max_revoke_approvals: () -> (opt nat) query;
   icrc37_metadata: () -> (vec record {
                                 text;
                                 Value;
                               }) query;
   icrc37_revoke_collection_approvals: (args:
    vec RevokeCollectionApprovalArg) ->
    (vec opt RevokeCollectionApprovalResult);
   icrc37_revoke_token_approvals: (args: vec RevokeTokenApprovalArg) ->
    (vec opt RevokeTokenApprovalResult);
   icrc37_transfer_from: (args: vec TransferFromArg) ->
    (vec opt TransferFromResult);
   icrc3_get_archives: (args: GetArchivesArgs) -> (GetArchivesResult) query;
   icrc3_get_blocks: (args: GetBlocksArgs) -> (GetBlocksResult) query;
   icrc3_get_tip_certificate: () -> (opt DataCertificate) query;
   icrc3_log_status: () -> (LogStatus) query;
   /// Where each archive stands with its RegisterDappCanisters proposal.
   icrc3_registration_status: () -> (Status) query;
   icrc3_supported_block_types: () -> (vec BlockType) query;
   icrc7_atomic_batch_transfers: () -> (opt bool) query;
   icrc7_balance_of: (accounts: vec Account) -> (vec nat) query;
   icrc7_collection_metadata: () -> (vec record {
                                           text;
                                           Value;
                                         }) query;
   icrc7_default_take_value: () -> (opt nat) query;
   icrc7_description: () -> (opt text) query;
   icrc7_logo: () -> (opt text) query;
   icrc7_max_memo_size: () -> (opt nat) query;
   icrc7_max_query_batch_size: () -> (opt nat) query;
   icrc7_max_take_value: () -> (opt nat) query;
   icrc7_max_update_batch_size: () -> (opt nat) query;
   icrc7_name: () -> (text) query;
   icrc7_owner_of: (ids: vec nat) -> (vec opt Account) query;
   icrc7_permitted_drift: () -> (opt nat) query;
   icrc7_supply_cap: () -> (opt nat) query;
   icrc7_symbol: () -> (text) query;
   icrc7_token_metadata: (ids: vec nat) ->
    (vec opt vec record {
                   text;
                   Value;
                 }) query;
   icrc7_tokens: (prev: opt nat, take: opt nat) -> (vec nat) query;
   icrc7_tokens_of: (account: Account, prev: opt nat, take: opt nat) ->
    (vec nat) query;
   icrc7_total_supply: () -> (nat) query;
   icrc7_transfer: (args: vec TransferArg) -> (vec opt TransferResult__1);
   icrc7_tx_window: () -> (opt nat) query;
   /// Add to the dissolve delay (a lock without one gets one). While dissolving, the end moves
   /// out by the same amount. Lock period + delay stay within the max lock length.
   increase_dissolve_delay: (lock_id: LockId, additional_ns: nat64) ->
    (LockOpResult);
   /// Compatibility entry point for older frontends: performs the claim
   /// synchronously and returns the history id, which get_claim_request_status
   /// then reports as completed or failed.
   request_claim_and_withdraw: (swap_canister_id: SwapCanisterId,
    position_id: PositionId) -> (ClaimAndWithdrawResult);
   set_max_lock_length_days: (new_max_lock_length_days: nat64) -> ();
   /// Start dissolving: allowed once the lock period has ended, for a lock with a delay.
   start_dissolving: (lock_id: LockId) -> (LockOpResult);
   /// Stop dissolving: the time left becomes the delay again.
   stop_dissolving: (lock_id: LockId) -> (LockOpResult);
   transfer_position: (to: principal, swap_canister_id: principal,
    position_id: PositionId) -> (TransferPositionResult);
   transfer_position_ownership: (to_principal: principal, swap_canister_id:
    SwapCanisterId, position_id: PositionId) ->
    (TransferPositionOwnershipResult);
   transfer_token_lock_ownership: (to_principal: principal, token_type:
    TokenType, lock_id: LockId) -> (TransferTokenLockOwnershipResult);
   transfer_tokens: (to_principal: principal, to_subaccount: opt Subaccount,
    icrc1_ledger_canister_id: principal, amount: Balance) -> (TransferResult);
   update_position_lock: (swap_canister_id: principal, position_id:
    PositionId, expires_at: Expiry) -> (CreateLockResult);
 };
type SettingsUpdate = 
 record {
   archive_initial_cycles: opt nat;
   archive_max_blocks: opt nat;
   archive_top_up_amount: opt nat;
   archive_top_up_threshold: opt nat;
   max_live_blocks: opt nat;
   spill_batch_size: opt nat;
 };
type Settings = 
 record {
   archive_initial_cycles: nat;
   archive_max_blocks: nat;
   archive_top_up_amount: nat;
   archive_top_up_threshold: nat;
   max_live_blocks: nat;
   spill_batch_size: nat;
 };
type RevokeTokenApprovalResult = 
 variant {
   Err: RevokeTokenApprovalError;
   Ok: nat;
 };
type RevokeTokenApprovalError = 
 variant {
   ApprovalDoesNotExist;
   CreatedInFuture: record {ledger_time: nat64;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   NonExistingTokenId;
   TooOld;
   Unauthorized;
 };
type RevokeTokenApprovalArg = 
 record {
   created_at_time: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   spender: opt Account;
   token_id: nat;
 };
type RevokeCollectionApprovalResult = 
 variant {
   Err: RevokeCollectionApprovalError;
   Ok: nat;
 };
type RevokeCollectionApprovalError = 
 variant {
   ApprovalDoesNotExist;
   CreatedInFuture: record {ledger_time: nat64;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   TooOld;
 };
type RevokeCollectionApprovalArg = 
 record {
   created_at_time: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   spender: opt Account;
 };
type Registration = 
 record {
   attempts: nat;
   canister_id: principal;
   last_error: opt text;
   proposal_id: opt nat64;
   start: nat;
 };
type PositionLock = 
 record {
   dex: Dex;
   expiry: Expiry;
   lock_id: LockId;
   position_id: PositionId;
   token0: TokenType;
   token1: TokenType;
 };
type PositionId = nat;
type PaymentLogEntry = 
 record {
   amount_e8s: nat;
   correlation_id: nat;
   icp_transaction_id: nat;
   id: nat;
   lock_type: LockType;
   payer: principal;
   timestamp: Timestamp;
 };
type LogStatus = 
 record {
   archives: vec ArchiveInfo;
   history_imported: bool;
   last_block_hash: opt blob;
   live_blocks: nat;
   live_first_index: nat;
   log_length: nat;
   settings: Settings;
   spilling: bool;
 };
type LockType = 
 variant {
   PositionLock;
   TokenLock;
 };
type LockState = 
 record {
   amount: opt Balance;
   archived: bool;
   created_at: opt nat64;
   dissolve_delay: nat64;
   dissolving_until: opt Expiry;
   earliest_unlock: Expiry;
   expiry: Expiry;
   kind: LockType;
   ledger: opt TokenType;
   lock_end: Expiry;
   lock_id: LockId;
   locked: bool;
   owner: principal;
   owner_subaccount: opt blob;
   position_id: opt PositionId;
   swap_canister_id: opt SwapCanisterId;
   token0: opt TokenType;
   token1: opt TokenType;
 };
type LockPageQuery = 
 record {
   include_archived: bool;
   kind: opt LockType;
   ledger: opt TokenType;
   owner: opt principal;
   prev: opt LockId;
   swap_canister_id: opt SwapCanisterId;
   take: opt nat;
 };
type LockOpResult = 
 variant {
   Err: LockOpError;
   Ok: LockState;
 };
type LockOpError = 
 variant {
   InProgress;
   Invalid: text;
   NotFound;
   NotOwner;
 };
type LockLimits = 
 record {
   max_lock_length_ns: nat64;
   min_lock_length_ns: nat64;
 };
type LockInfo = 
 variant {
   PositionLock: FullyQualifiedPositionLock;
   TokenLock: FullyQualifiedLock;
 };
type LockId = nat;
type Lock = 
 record {
   amount: Balance;
   expiry: Expiry;
   lock_id: LockId;
 };
type IsApprovedArg = 
 record {
   from_subaccount: opt blob;
   spender: Account;
   token_id: nat;
 };
type GetBlocksResult = 
 record {
   archived_blocks: vec ArchivedBlocks;
   blocks: vec Block;
   log_length: nat;
 };
type GetBlocksArgs = vec BlockRange;
type GetArchivesResult = vec ArchiveRange;
type GetArchivesArgs = record {from: opt principal;};
type FullyQualifiedPositionLock = 
 record {
   principal;
   SwapCanisterId;
   PositionLock;
 };
type FullyQualifiedLock = 
 record {
   principal;
   TokenType;
   Lock;
 };
type Expiry = nat64;
type Dex = nat;
type DataCertificate = 
 record {
   certificate: blob;
   hash_tree: blob;
 };
type CreateLockResult = 
 variant {
   Err: CreateLockError;
   Ok: LockId;
 };
type CreateLockError = 
 record {
   message: text;
   transfer_error: opt TransferError;
 };
type CollectionApproval = 
 record {
   created_at_time: nat64;
   expires_at: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   spender: Account;
 };
type ClaimedPosition = 
 record {
   owner: principal;
   position_id: PositionId;
   position_lock: opt PositionLock;
   swap_canister_id: SwapCanisterId;
 };
type ClaimRequestStatus = 
 variant {
   BalanceRecorded:
    record {
      balance0_before: Balance;
      balance1_before: Balance;
    };
   ClaimAttempted:
    record {
      balance0_before: Balance;
      balance1_before: Balance;
      claim_attempt: nat;
    };
   ClaimVerified:
    record {
      amount0_claimed: Balance;
      amount1_claimed: Balance;
      balance0_before: Balance;
      balance1_before: Balance;
    };
   Completed:
    record {
      amount0_claimed: Balance;
      amount0_transferred: Balance;
      amount1_claimed: Balance;
      amount1_transferred: Balance;
      transfer0_tx_id: opt nat;
      transfer1_tx_id: opt nat;
    };
   Failed: text;
   Pending;
   Processing;
   TimedOut;
   Withdrawn: record {
                amount0_claimed: Balance;
                amount1_claimed: Balance;
              };
 };
type ClaimRequestId = nat;
type ClaimRequest = 
 record {
   caller: principal;
   completed_at: opt Timestamp;
   created_at: Timestamp;
   last_attempted_at: opt Timestamp;
   position_id: PositionId;
   request_id: ClaimRequestId;
   retry_count: nat;
   started_processing_at: opt Timestamp;
   status: ClaimRequestStatus;
   swap_canister_id: SwapCanisterId;
   token0: TokenType;
   token1: TokenType;
 };
type ClaimFeesResult = 
 variant {
   Err: text;
   Ok:
    record {
      amount0: nat;
      amount1: nat;
      request_id: ClaimRequestId;
      token0: TokenType;
      token1: TokenType;
    };
 };
type ClaimAndWithdrawResult = 
 variant {
   Err: text;
   Ok: ClaimRequestId;
 };
type BufferEntry = 
 record {
   caller: principal;
   content: text;
   correlation_id: nat;
   id: nat;
   timestamp: int;
 };
type BlockType = 
 record {
   block_type: text;
   url: text;
 };
type BlockRange = 
 record {
   length: nat;
   start: nat;
 };
type Block = 
 record {
   block: Value__1;
   id: nat;
 };
type Balance = nat;
type ArchivedBlocks = 
 record {
   args: GetBlocksArgs;
   callback: func (GetBlocksArgs) -> (GetBlocksResult) query;
 };
type ArchiveRange = 
 record {
   canister_id: principal;
   end: nat;
   start: nat;
 };
type ArchiveInfo = 
 record {
   canister_id: principal;
   length: nat;
   max_blocks: nat;
   start: nat;
 };
type ApproveTokenResult = 
 variant {
   Err: ApproveTokenError;
   Ok: nat;
 };
type ApproveTokenError = 
 variant {
   CreatedInFuture: record {ledger_time: nat64;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InvalidSpender;
   NonExistingTokenId;
   TooOld;
   Unauthorized;
 };
type ApproveTokenArg = 
 record {
   approval_info: ApprovalInfo;
   token_id: nat;
 };
type ApproveCollectionResult = 
 variant {
   Err: ApproveCollectionError;
   Ok: nat;
 };
type ApproveCollectionError = 
 variant {
   CreatedInFuture: record {ledger_time: nat64;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InvalidSpender;
   TooOld;
 };
type ApproveCollectionArg = record {approval_info: ApprovalInfo;};
type ApprovalInfo = 
 record {
   created_at_time: nat64;
   expires_at: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   spender: Account;
 };
type AddLiquidityResult = 
 variant {
   Err: text;
   Ok:
    record {
      credited0: nat;
      credited1: nat;
      increase_error: opt text;
      position_id: PositionId;
      returned0: nat;
      returned1: nat;
      used0: nat;
      used1: nat;
    };
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : () -> SneedLock
