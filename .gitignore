# Various IDEs and Editors
.vscode/
.idea/
**/*~

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# dfx temporary files
.dfx/

# generated files
**/declarations/

# rust
target/

# frontend code
node_modules/
dist/
.svelte-kit/

# environment variables
.env

# ignore package-lock.json in any folder
**/package-lock.json
# ...except the root one: the frontend is released by SNS proposal and voters must rebuild
# byte-identical assets (spec/frontend_dao_handoff.md), which needs the exact dependency versions
!/package-lock.json

ref/

.mops

# Scratch files in spec
spec/scratch*

# Internal review reports in spec
spec/reports/

# Windows / WSL zone metadata files
**/*:Zone.Identifier

# generated by src/app_sneeddao_frontend/scripts/build-api-docs.mjs at build time
src/app_sneeddao_frontend/public/api-docs/*.did
src/app_sneeddao_frontend/public/api-docs/*.did.js
!src/app_sneeddao_frontend/public/api-docs/sneed_names.did
!src/app_sneeddao_frontend/public/api-docs/sneed_names.did.js
src/app_sneeddao_frontend/public/.well-known/agent-skills/index.json
src/app_sneeddao_frontend/public/.well-known/ii-derivation-origin
src/app_sneeddao_frontend/public/.well-known/ic-architecture

# canister test artifacts
test/canisters/build/
